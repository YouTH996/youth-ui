<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="100dp"
    android:background="@drawable/card_background_rounded"
    android:layout_marginEnd="12dp"
    android:elevation="4dp">

    <!-- 中心：汽车俯视图 -->
    <ImageView
        android:id="@+id/img_car_ty"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:src="@drawable/car_ty_placeholder"
        android:scaleType="fitCenter" />

    <!-- 左上：左前轮胎压 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="start|top"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/text_tire_fl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.3"
            android:textSize="18sp"
            android:textColor="@color/dark_tech_accent"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bar"
            android:textSize="12sp"
            android:textColor="@color/dark_tech_text_secondary"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- 右上：右前轮胎压 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/text_tire_fr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.4"
            android:textSize="18sp"
            android:textColor="@color/dark_tech_accent"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bar"
            android:textSize="12sp"
            android:textColor="@color/dark_tech_text_secondary"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- 左下：左后轮胎压 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/text_tire_rl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.3"
            android:textSize="18sp"
            android:textColor="@color/dark_tech_accent"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bar"
            android:textSize="12sp"
            android:textColor="@color/dark_tech_text_secondary"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- 右下：右后轮胎压 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/text_tire_rr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.5"
            android:textSize="18sp"
            android:textColor="@color/dark_tech_accent"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bar"
            android:textSize="12sp"
            android:textColor="@color/dark_tech_text_secondary"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- 胎温显示在底部中间 -->
    <TextView
        android:id="@+id/text_tire_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="胎温: 45°C"
        android:textSize="11sp"
        android:textColor="@color/dark_tech_text"
        android:layout_marginBottom="6dp" />

</FrameLayout>
