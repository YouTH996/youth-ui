<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/desktop_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desktop_wallpaper_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 状态栏 -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/statusbar_background_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

        <!-- 左侧：语音按钮、档位、电量 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 小迪语音按钮 -->
            <ImageView
                android:id="@+id/img_voice_assistant"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <!-- 档位显示 -->
            <LinearLayout
                android:id="@+id/gear_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_gear_p"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_gear_n"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_gear_d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <!-- 电量及续航 - 使用自定义 BatteryView -->
            <com.youth.desktop.BatteryView
                android:id="@+id/battery_view"
                android:layout_width="120dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <!-- 右侧：WiFi、蓝牙、4G、行车记录仪、时间 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <!-- WiFi -->
            <ImageView
                android:id="@+id/img_wifi"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="6dp"
                android:layout_height="0dp" />

            <!-- 蓝牙 -->
            <ImageView
                android:id="@+id/img_bluetooth"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="6dp"
                android:layout_height="0dp" />

            <!-- 4G信号 -->
            <ImageView
                android:id="@+id/img_4g_signal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="6dp"
                android:layout_height="0dp" />

            <!-- 行车记录仪 -->
            <ImageView
                android:id="@+id/img_driving_recorder"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <!-- 时间 -->
            <TextView
                android:id="@+id/text_time_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="@color/statusbar_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        </LinearLayout>

        <!-- 图标网格 -->
        <GridLayout
            android:id="@+id/icon_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="56dp" />

    </LinearLayout>

    <!-- 卡片容器区域 - 显示在底部任务栏上方 -->
    <HorizontalScrollView
        android:id="@+id/card_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/card_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="@drawable/taskbar_background_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <!-- 左侧：导航按钮组 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_back"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btn_home"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_home"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btn_recent"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_recent"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中间：空调控制面板 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/frosted_glass_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- 左侧：温度控制 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 空调开关 -->
                <LinearLayout
                    android:id="@+id/btn_ac_power"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_ac_power"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- 温度减小 -->
                <LinearLayout
                    android:id="@+id/btn_ac_minus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_ac_minus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <!-- 当前温度显示 -->
                <LinearLayout
                    android:id="@+id/ac_temp_display"
                    android:layout_width="52dp"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/icon_background">

                    <TextView
                        android:id="@+id/ac_temp_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26°C"
                        android:textSize="18sp"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- 温度增大 -->
                <LinearLayout
                    android:id="@+id/btn_ac_plus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_ac_plus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="@color/text_hint"
                android:alpha="0.3" />

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- 右侧：其他空调功能 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 前挡风除霜 -->
                <LinearLayout
                    android:id="@+id/btn_defrost_front"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_defrost_front"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- 后挡风玻璃除霜 -->
                <LinearLayout
                    android:id="@+id/btn_defrost_rear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_defrost_rear"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- 吹风角度调节 -->
                <LinearLayout
                    android:id="@+id/btn_air_direction"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_air_direction"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧：桌面设置按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_desktop_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_settings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
