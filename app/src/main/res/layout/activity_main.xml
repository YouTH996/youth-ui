<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/desktop_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/desktop_wallpaper_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="0dp"
        android:id="@+id/desktop_main_layout">

        <!-- 状态栏 -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/statusbar_background_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

        <!-- 左侧：语音按钮、档位、电量 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 小迪语音按钮 -->
            <ImageView
                android:id="@+id/img_voice_assistant"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <!-- 档位显示 -->
            <LinearLayout
                android:id="@+id/gear_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_gear_p"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_gear_r"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_gear_n"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/text_gear_d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="D"
                    android:textSize="16sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <!-- 电量及续航 - 使用自定义 BatteryView -->
            <cn.youth996.ui.view.BatteryView
                android:id="@+id/battery_view"
                android:layout_width="120dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <!-- 右侧：WiFi、蓝牙、4G、行车记录仪、时间 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <!-- WiFi -->
            <ImageView
                android:id="@+id/img_wifi"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="6dp"
                android:layout_height="0dp" />

            <!-- 蓝牙 -->
            <ImageView
                android:id="@+id/img_bluetooth"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="6dp"
                android:layout_height="0dp" />

            <!-- 4G信号 -->
            <ImageView
                android:id="@+id/img_4g_signal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="6dp"
                android:layout_height="0dp" />

            <!-- 行车记录仪 -->
            <ImageView
                android:id="@+id/img_driving_recorder"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <!-- 时间 -->
            <TextView
                android:id="@+id/text_time_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="@color/statusbar_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        </LinearLayout>

        <!-- 中间区域：左侧导航 + 右侧音乐播放 -->
        <LinearLayout
            android:id="@+id/center_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/center_area_margin_top"
            android:layout_marginBottom="@dimen/center_area_margin_bottom"
            android:paddingStart="@dimen/center_area_padding_h"
            android:paddingEnd="@dimen/center_area_padding_h">

            <!-- 左侧：导航软件 -->
            <FrameLayout
                android:id="@+id/nav_preview_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/card_background_rounded"
                android:layout_marginEnd="8dp">

                <!-- 驾驶模式：显示车辆图标和车速 -->
                <LinearLayout
                    android:id="@+id/driving_mode_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:visibility="visible">

                    <!-- 车辆图标 -->
                    <ImageView
                        android:id="@+id/img_car_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/car_ty_placeholder"
                        android:scaleType="fitCenter" />

                    <!-- 车速显示 -->
                    <TextView
                        android:id="@+id/text_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="36sp"
                        android:textColor="@color/dark_tech_accent"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="km/h"
                        android:textSize="14sp"
                        android:textColor="@color/dark_tech_text"
                        android:fontFamily="sans-serif-medium" />

                    <!-- 状态标签 -->
                    <TextView
                        android:id="@+id/text_driving_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="驾驶模式"
                        android:textSize="11sp"
                        android:textColor="@color/dark_tech_text"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp"
                        android:alpha="0.7" />
                </LinearLayout>

                <!-- 画中画模式：显示高德地图 -->
                <LinearLayout
                    android:id="@+id/pip_mode_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:visibility="gone">

                    <!-- 画中画预览容器 -->
                    <FrameLayout
                        android:id="@+id/pip_preview_frame"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_background_rounded"
                        android:padding="4dp">

                        <!-- 画中画占位图标 -->
                        <ImageView
                            android:id="@+id/img_pip_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_nav_default"
                            android:scaleType="fitCenter" />

                        <!-- 画中画状态文字 -->
                        <TextView
                            android:id="@+id/text_pip_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:text="高德地图画中画"
                            android:textSize="10sp"
                            android:textColor="@color/dark_tech_accent"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp" />
                    </FrameLayout>

                    <!-- 画中画模式标签 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="画中画模式"
                        android:textSize="11sp"
                        android:textColor="@color/dark_tech_text"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="8dp"
                        android:alpha="0.7" />
                </LinearLayout>

                <!-- 导航模式：显示导航预览 -->
                <LinearLayout
                    android:id="@+id/nav_mode_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/img_nav_preview"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/text_nav_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导航"
                        android:textSize="12sp"
                        android:textColor="@color/dark_tech_text"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </FrameLayout>

            <!-- 右侧：音乐播放卡片 -->
            <RelativeLayout
                android:id="@+id/music_player_card"
                android:layout_width="@dimen/music_card_width"
                android:layout_height="match_parent"
                android:background="@drawable/card_background_rounded"
                android:padding="16dp"
                android:layout_marginStart="8dp">

                <!-- 左上角：软件图标 -->
                <ImageView
                    android:id="@+id/img_music_source_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@mipmap/ic_launcher"
                    android:scaleType="fitCenter"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true" />

                <TextView
                    android:id="@+id/text_music_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="网易云音乐"
                    android:textSize="11sp"
                    android:textColor="@color/dark_tech_accent"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:layout_toEndOf="@id/img_music_source_icon"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="4dp" />

                <!-- 中间：歌曲图标（圆角） -->
                <ImageView
                    android:id="@+id/img_album_cover_center"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_default"
                    android:scaleType="centerCrop"
                    android:layout_below="@id/img_music_source_icon"
                    android:layout_marginTop="4dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/album_cover_rounded" />

                <!-- 歌曲名称 -->
                <TextView
                    android:id="@+id/text_song_title_center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="演员"
                    android:textSize="14sp"
                    android:textColor="@color/dark_tech_text"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_below="@id/img_album_cover_center"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 歌手名称 -->
                <TextView
                    android:id="@+id/text_song_artist_center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="薛之谦"
                    android:textSize="11sp"
                    android:textColor="@color/dark_tech_text_secondary"
                    android:gravity="center"
                    android:layout_below="@id/text_song_title_center"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 歌词区域 -->
                <LinearLayout
                    android:id="@+id/layout_lyrics_center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_below="@id/text_song_artist_center"
                    android:layout_marginTop="4dp"
                    android:minHeight="130dp">

                    <!-- 第1句歌词 -->
                    <TextView
                        android:id="@+id/text_lyric_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/dark_tech_text_secondary"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:alpha="0.4" />

                    <!-- 第2句歌词 -->
                    <TextView
                        android:id="@+id/text_lyric_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/dark_tech_text_secondary"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:alpha="0.6" />

                    <!-- 当前播放歌词（高亮） -->
                    <TextView
                        android:id="@+id/text_lyric_current_center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="该配合你演出的我演视而不见"
                        android:textSize="14sp"
                        android:textColor="@color/dark_tech_accent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- 第4句歌词 -->
                    <TextView
                        android:id="@+id/text_lyric_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/dark_tech_text_secondary"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:alpha="0.6" />

                    <!-- 第5句歌词 -->
                    <TextView
                        android:id="@+id/text_lyric_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/dark_tech_text_secondary"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:alpha="0.4" />
                </LinearLayout>

                <!-- 控制按钮 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_below="@id/layout_lyrics_center"
                    android:layout_marginTop="2dp"
                    android:layout_centerHorizontal="true">

                    <ImageView
                        android:id="@+id/btn_previous_center"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_previous"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <ImageView
                        android:id="@+id/btn_play_pause_center"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_play"
                        android:scaleType="fitCenter"
                        android:padding="8dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <ImageView
                        android:id="@+id/btn_next_center"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_next"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 卡片容器区域 - 显示在底部任务栏上方 -->
    <HorizontalScrollView
        android:id="@+id/card_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/card_container_margin_bottom"
        android:paddingStart="@dimen/card_container_padding_h"
        android:paddingEnd="@dimen/card_container_padding_h">

        <LinearLayout
            android:id="@+id/card_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:background="@drawable/taskbar_background_dark"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <!-- 左侧：导航按钮组 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_back"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_back"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btn_home"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_home"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/btn_recent"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_recent"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中间：空调控制面板 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/frosted_glass_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- 左侧：温度控制 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 空调开关 -->
                <LinearLayout
                    android:id="@+id/btn_ac_power"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_ac_power"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- 温度减小 -->
                <LinearLayout
                    android:id="@+id/btn_ac_minus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_ac_minus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <!-- 当前温度显示 -->
                <LinearLayout
                    android:id="@+id/ac_temp_display"
                    android:layout_width="52dp"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/icon_background">

                    <TextView
                        android:id="@+id/ac_temp_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26°C"
                        android:textSize="18sp"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- 温度增大 -->
                <LinearLayout
                    android:id="@+id/btn_ac_plus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_ac_plus"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:background="@color/text_hint"
                android:alpha="0.3" />

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <!-- 右侧：其他空调功能 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 前挡风除霜 -->
                <LinearLayout
                    android:id="@+id/btn_defrost_front"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_defrost_front"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- 后挡风玻璃除霜 -->
                <LinearLayout
                    android:id="@+id/btn_defrost_rear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_defrost_rear"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <!-- 吹风角度调节 -->
                <LinearLayout
                    android:id="@+id/btn_air_direction"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/icon_background_selector">

                    <ImageView
                        android:id="@+id/img_air_direction"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧：桌面设置按钮和悬浮窗控制按钮 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 悬浮地图按钮 -->
            <LinearLayout
                android:id="@+id/btn_floating_map"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_dialog_map"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="悬浮地图"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 关闭悬浮窗按钮 -->
            <LinearLayout
                android:id="@+id/btn_close_floating"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关闭悬浮"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 高德地图悬浮窗按钮 -->
            <LinearLayout
                android:id="@+id/btn_amap_float"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_mapmode"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="高德悬浮"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 自定义悬浮窗按钮 -->
            <LinearLayout
                android:id="@+id/btn_custom_float"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_add"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自定义"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 切换悬浮窗按钮 -->
            <LinearLayout
                android:id="@+id/btn_toggle_floating"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="切换悬浮"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 桌面设置按钮 -->
            <LinearLayout
                android:id="@+id/btn_desktop_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/icon_background_selector">

                <ImageView
                    android:id="@+id/img_settings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
