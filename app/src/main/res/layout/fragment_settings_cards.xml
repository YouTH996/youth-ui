<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_tech_bg"
    android:padding="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 卡片显示开关 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="卡片管理"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示桌面卡片"
                    android:textSize="14sp"
                    android:textColor="@color/dark_tech_text" />

                <Switch
                    android:id="@+id/switch_show_cards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/dark_tech_accent"
                    android:trackTint="@color/dark_tech_bg_light" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light" />

            <!-- 可用卡片列表 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可用卡片"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingTop="16dp"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_available_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light"
                android:layout_marginVertical="16dp" />

            <!-- 已启用卡片 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已启用卡片"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_enabled_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light"
                android:layout_marginVertical="16dp" />

            <!-- 卡片样式 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="卡片样式"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="卡片圆角"
                    android:textSize="14sp"
                    android:textColor="@color/dark_tech_text" />

                <SeekBar
                    android:id="@+id/seekbar_card_corner_radius"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:max="30"
                    android:progress="15"
                    android:progressTint="@color/dark_tech_accent"
                    android:thumbTint="@color/dark_tech_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="卡片透明度"
                    android:textSize="14sp"
                    android:textColor="@color/dark_tech_text" />

                <SeekBar
                    android:id="@+id/seekbar_card_alpha"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80"
                    android:progressTint="@color/dark_tech_accent"
                    android:thumbTint="@color/dark_tech_accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示卡片阴影"
                    android:textSize="14sp"
                    android:textColor="@color/dark_tech_text" />

                <Switch
                    android:id="@+id/switch_card_shadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/dark_tech_accent"
                    android:trackTint="@color/dark_tech_bg_light" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
