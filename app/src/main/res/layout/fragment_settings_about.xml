<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_tech_bg"
    android:padding="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- 应用图标 -->
            <ImageView
                android:id="@+id/img_app_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@mipmap/ic_launcher"
                android:layout_marginBottom="16dp" />

            <!-- 应用名称 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Youth桌面"
                android:textSize="20sp"
                android:textColor="@color/dark_tech_text"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="8dp" />

            <!-- 版本信息 -->
            <TextView
                android:id="@+id/text_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="版本 1.0.0"
                android:textSize="13sp"
                android:textColor="@color/dark_tech_text_secondary"
                android:gravity="center"
                android:paddingBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light"
                android:layout_marginBottom="24dp" />

            <!-- 应用介绍 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="应用介绍"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Youth桌面是一款基于Android平台开发的现代化车机桌面系统。参考叁迪UI桌面的设计风格，为用户提供流畅、美观、实用的桌面体验。"
                android:textSize="13sp"
                android:textColor="@color/dark_tech_text_secondary"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light"
                android:layout_marginBottom="24dp" />

            <!-- 功能特点 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="功能特点"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_white"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="桌面图标网格布局"
                    android:textSize="13sp"
                    android:textColor="@color/dark_tech_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_white"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="应用抽屉快速访问"
                    android:textSize="13sp"
                    android:textColor="@color/dark_tech_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_white"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="多主题切换和壁纸设置"
                    android:textSize="13sp"
                    android:textColor="@color/dark_tech_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_white"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="空调控制面板"
                    android:textSize="13sp"
                    android:textColor="@color/dark_tech_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_white"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="车机风格界面设计"
                    android:textSize="13sp"
                    android:textColor="@color/dark_tech_text" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light"
                android:layout_marginVertical="24dp" />

            <!-- 联系与支持 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="联系与支持"
                android:textSize="14sp"
                android:textColor="@color/dark_tech_accent"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btn_feedback"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="意见反馈"
                android:textSize="13sp"
                android:textColor="@color/dark_tech_text"
                android:background="@drawable/button_background_dark"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_rate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="给我们评分"
                android:textSize="13sp"
                android:textColor="@color/dark_tech_text"
                android:background="@drawable/button_background_dark"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_privacy"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="隐私政策"
                android:textSize="13sp"
                android:textColor="@color/dark_tech_text"
                android:background="@drawable/button_background_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/dark_tech_bg_light"
                android:layout_marginVertical="24dp" />

            <!-- 版权信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2024 Youth Desktop Team"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text_secondary"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
