<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <!-- 弹窗主体：与设置弹窗一致的深色圆角面板 -->
    <LinearLayout
        android:id="@+id/drawer_container"
        android:layout_width="800dp"
        android:layout_height="350dp"
        android:layout_gravity="center"
        android:background="@drawable/dialog_background_rounded"
        android:orientation="vertical"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="所有应用"
                android:textSize="18sp"
                android:textColor="@color/dark_tech_text"
                android:fontFamily="sans-serif-medium" />

            <EditText
                android:id="@+id/search_box"
                android:layout_width="220dp"
                android:layout_height="40dp"
                android:background="@drawable/search_box_dark"
                android:hint="搜索应用"
                android:textColor="@color/dark_tech_text"
                android:textColorHint="#99FFFFFF"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/home_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/dark_tech_text"
                android:contentDescription="返回桌面" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@color/dark_tech_text"
                android:contentDescription="关闭" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
