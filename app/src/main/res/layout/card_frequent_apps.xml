<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background_rounded"
    android:padding="12dp"
    android:layout_marginEnd="12dp"
    android:elevation="4dp">

    <!-- 应用图标网格 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 应用1 -->
        <LinearLayout
            android:id="@+id/btn_app_1"
            android:layout_width="72dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp">

            <ImageView
                android:id="@+id/img_app_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/text_app_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 应用2 -->
        <LinearLayout
            android:id="@+id/btn_app_2"
            android:layout_width="72dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/img_app_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/text_app_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 应用3 -->
        <LinearLayout
            android:id="@+id/btn_app_3"
            android:layout_width="72dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/img_app_3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/text_app_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 管理按钮 -->
        <LinearLayout
            android:id="@+id/btn_manage_apps"
            android:layout_width="72dp"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/img_manage_apps"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_plus" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="添加"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="6dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
