<?xml version="1.0" encoding="utf-8"?>
<!--
  车辆控制卡片（第三轮优化 - 解决"挤成小方块"问题）

  - 容器固定一个合理宽度（与导航卡接近），保证不会被其他卡挤掉；
  - 三块区域 weight 分布，左侧车图大，右侧锁车/后备箱略小；
  - 无分隔线。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:background="@drawable/card_background_rounded"
    android:padding="8dp"
    android:layout_marginEnd="10dp"
    android:elevation="4dp"
    android:gravity="center_vertical">

    <!-- 左侧车辆图标（主图标，明显更大） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/img_car"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 解锁/锁车按钮 -->
    <LinearLayout
        android:id="@+id/btn_lock_unlock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/img_lock_unlock"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 后备箱按钮 -->
    <LinearLayout
        android:id="@+id/btn_trunk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/img_trunk"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

</LinearLayout>
