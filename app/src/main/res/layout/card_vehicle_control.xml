<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="100dp"
    android:orientation="vertical"
    android:background="@drawable/card_background_rounded"
    android:padding="12dp"
    android:layout_marginEnd="12dp"
    android:elevation="4dp">

    <!-- 卡片标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="快捷控制"
        android:textSize="14sp"
        android:textColor="@color/dark_tech_text"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- 控制按钮网格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 车窗解锁 -->
        <LinearLayout
            android:id="@+id/btn_unlock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_control_button_background"
            android:padding="4dp">

            <ImageView
                android:id="@+id/img_unlock"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_unlock"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="解锁"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <!-- 车窗控制 -->
        <LinearLayout
            android:id="@+id/btn_window"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_control_button_background"
            android:padding="4dp">

            <ImageView
                android:id="@+id/img_window"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_window"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="车窗"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <!-- 后备箱 -->
        <LinearLayout
            android:id="@+id/btn_trunk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_control_button_background"
            android:padding="4dp">

            <ImageView
                android:id="@+id/img_trunk"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_trunk"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后备箱"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <!-- 寻车 -->
        <LinearLayout
            android:id="@+id/btn_find_car"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_control_button_background"
            android:padding="4dp">

            <ImageView
                android:id="@+id/img_find_car"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_find_car"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="寻车"
                android:textSize="11sp"
                android:textColor="@color/dark_tech_text"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
