<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background_rounded"
    android:padding="16dp"
    android:layout_marginEnd="12dp"
    android:elevation="4dp"
    android:gravity="center_vertical">

    <!-- 车辆图标 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/img_car"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="1dp"
        android:layout_height="64dp"
        android:background="@color/dark_tech_text_secondary"
        android:alpha="0.3"
        android:layout_marginEnd="16dp" />

    <!-- 控制按钮区域 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 解锁/锁车按钮 -->
        <LinearLayout
            android:id="@+id/btn_lock_unlock"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp">

            <ImageView
                android:id="@+id/img_lock_unlock"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="48dp"
            android:background="@color/dark_tech_text_secondary"
            android:alpha="0.3"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <!-- 后备箱按钮 -->
        <LinearLayout
            android:id="@+id/btn_trunk"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp">

            <ImageView
                android:id="@+id/img_trunk"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
