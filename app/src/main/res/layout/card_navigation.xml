<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background_rounded"
    android:padding="16dp"
    android:layout_marginEnd="12dp"
    android:elevation="4dp"
    android:gravity="center_vertical">

    <!-- 导航图标 -->
    <LinearLayout
        android:id="@+id/btn_nav_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">

        <ImageView
            android:id="@+id/img_nav_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="1dp"
        android:layout_height="48dp"
        android:background="@color/dark_tech_text_secondary"
        android:alpha="0.3"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <!-- 回家图标 -->
    <LinearLayout
        android:id="@+id/btn_nav_home"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">

        <ImageView
            android:id="@+id/img_nav_home"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="1dp"
        android:layout_height="48dp"
        android:background="@color/dark_tech_text_secondary"
        android:alpha="0.3"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <!-- 去公司图标 -->
    <LinearLayout
        android:id="@+id/btn_nav_company"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp">

        <ImageView
            android:id="@+id/img_nav_company"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

</LinearLayout>
